{
  "trailingSlash": true,
  "redirects": [
    { "source": "/:path(.*)", "has": [{ "type": "host", "value": "www.maranatamarketing.com" }], "destination": "https://maranatamarketing.com/:path", "permanent": true },
    { "source": "/servicos/engenharia-digital/", "destination": "/servicos/criacao-de-sites/", "permanent": true }
  ],
  "headers": [
    { "source": "/(.*)", "headers": [
      { "key": "X-Content-Type-Options", "value": "nosniff" },
      { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
    ] },
    { "source": "/formulario/(.*)", "headers": [{ "key": "X-Robots-Tag", "value": "noindex, follow" }] },
    { "source": "/(lafavorita|valquiria|vanycardoso|pulsemotion)/(.*)", "headers": [{ "key": "X-Robots-Tag", "value": "noindex, follow" }] },
    { "source": "/(.*)\\.(png|jpg|jpeg|webp|avif|svg|woff2)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] }
  ]
}
